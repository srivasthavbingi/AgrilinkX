# AgriLinkX Frontend Environment Variables
# Copy this to .env and fill in your Supabase project details.
# Only use the publishable (public) key here — never the service-role key.

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable Key (safe for frontend)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

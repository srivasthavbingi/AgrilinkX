# AgriLinkX Backend Environment Variables
# Copy this file to .env and fill in your actual Supabase credentials.
# If left as-is (placeholder values), the backend will use in-memory fallback data.

# Supabase Project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (SECRET - never expose to frontend)
SUPABASE_KEY=your-service-role-key-here

# Government of India Open Data Platform API Key (data.gov.in)
DATAGOV_API_KEY=

